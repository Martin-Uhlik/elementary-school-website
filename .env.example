# Copy to .env and set a real password. .env is not committed.
POSTGRES_DB=zsmp
POSTGRES_USER=zsmp
POSTGRES_PASSWORD=change-me
# the Docker Hub account (or organization) the web and migrate images are pushed to by GitHub Actions
DOCKERHUB_NAMESPACE=CHANGE-ME
# which build to run: latest = the newest build of main; sha-<first 7 characters of a commit> = stay on that build
# (rollback; the automatic update then keeps it until this is set back to latest)
IMAGE_TAG=latest
# the domain Caddy serves and gets the HTTPS certificate for; ":80" = plain http without a certificate (dev machine)
SITE_ADDRESS="zsmp.cz, www.zsmp.cz"
# the site itself, reachable only from this machine (127.0.0.1) on this port
WEB_PORT=3000
# folder with galerie/, dokument/ and videos/ (the tour video and its zsmp.cs.vtt captions)
MEDIA_DIR=./media
DB_PORT=5432
# the admin sign-in cookie is https-only; set to false only to try /admin over plain http (SITE_ADDRESS=:80)
COOKIE_SECURE=true
# who can open the admin (/admin, /auth): IP addresses and CIDR ranges separated by commas, e.g. the school
# network (10.0.193.0/24) and the VPN pool (10.212.134.0/24); everyone else gets 404. Empty = nobody, * = everyone
# (only for trying it on a dev machine)
ADMIN_ALLOWED_IPS=10.0.193.0/24,10.212.134.0/24
# admin time limits: sign-out after inactivity (minutes), longest sign-in (minutes),
# wrong passwords before the account is locked, and how long it stays locked (minutes)
AUTH_INACTIVITY_MINUTES=30
AUTH_SESSION_MAX_MINUTES=480
AUTH_LOCKOUT_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=10
# sign-in and change logs (with IP addresses) are deleted after this many days
LOG_RETENTION_DAYS=180
