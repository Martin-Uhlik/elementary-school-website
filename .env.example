# Copy to .env and set a real password. .env is not committed.
POSTGRES_DB=zsmp
POSTGRES_USER=zsmp
POSTGRES_PASSWORD=change-me
# address the site listens on: the VM's address on the Hyper-V switch (192.168.100.10), or 127.0.0.1 on a dev machine
WEB_BIND=127.0.0.1
WEB_PORT=3000
# folder with galerie/, dokument/ and videos/ (the tour video and its zsmp.cs.vtt captions)
MEDIA_DIR=./media
DB_PORT=5432
# the admin sign-in cookie is https-only; set to false only to try /admin over plain http without IIS
COOKIE_SECURE=true
