<?xml version="1.0" encoding="UTF-8"?>
<!-- IIS site in front of the Docker containers: every request goes to the web container in the Ubuntu VM
     (192.168.100.10:3000, see "Server setup" in the README).
     Needs the URL Rewrite and Application Request Routing modules, with proxy enabled in ARR,
     and HTTP_X_FORWARDED_FOR, HTTP_X_FORWARDED_PROTO and HTTP_X_FORWARDED_HOST added to URL Rewrite's Allowed Server Variables. -->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- send http to https -->
        <rule name="HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}{REQUEST_URI}" appendQueryString="false" redirectType="Permanent" />
        </rule>
        <rule name="Next.js" stopProcessing="true">
          <match url="(.*)" />
          <serverVariables>
            <!-- the browser's real address, replacing any X-Forwarded-For it sent itself (the admin is allowed
                 by IP, see ADMIN_ALLOWED_IPS); ARR may add the same address again, the app reads the last one -->
            <set name="HTTP_X_FORWARDED_FOR" value="{REMOTE_ADDR}" />
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
          </serverVariables>
          <action type="Rewrite" url="http://192.168.100.10:3000/{R:1}" />
        </rule>
      </rules>
    </rewrite>
    <!-- Next.js sends its own error pages -->
    <httpErrors existingResponse="PassThrough" />
    <!-- room for large uploads later (100 MB) -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="104857600" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
